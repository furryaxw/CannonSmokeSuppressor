<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>CannonSmokeSuppressor</AssemblyName>
    <RootNamespace>CannonSmokeSuppressor</RootNamespace>
    <Version>2.5.1</Version>
    <AssemblyVersion>2.5.1.0</AssemblyVersion>
    <FileVersion>2.5.1.0</FileVersion>
    <Description>Suppresses persistent engine and muzzle smoke accumulation while retaining normal smoke.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/furryaxw/CannonSmokeSuppressor</RepositoryUrl>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Retain local reverse-engineering probes without compiling them into releases. -->
    <Compile Remove="SmokeNativeSpawnerMap.cs" />
    <Compile Remove="SmokeOutputCalibrationState.cs" />
    <Compile Remove="VfxNativeSpawnerOverride.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>..\..\..\MelonLoader\net6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>..\..\..\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>..\..\..\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
    </Reference>
    <Reference Include="MelonLoader">
      <HintPath>..\..\..\MelonLoader\net6\MelonLoader.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\..\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.VFXModule">
      <HintPath>..\..\..\MelonLoader\Il2CppAssemblies\UnityEngine.VFXModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.Vehicles">
      <HintPath>..\..\..\MelonLoader\Il2CppAssemblies\Il2CppSprocket.Vehicles.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppSprocket.Exhausts">
      <HintPath>..\..\..\MelonLoader\Il2CppAssemblies\Il2CppSprocket.Exhausts.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.EffectsFramework">
      <HintPath>..\..\..\MelonLoader\Il2CppAssemblies\Il2CppSprocket.EffectsFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.Powertrains">
      <HintPath>..\..\..\MelonLoader\Il2CppAssemblies\Il2CppSprocket.Powertrains.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.WeaponFramework">
      <HintPath>..\..\..\MelonLoader\Il2CppAssemblies\Il2CppSprocket.WeaponFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSprocket.Vehicles.Weapons">
      <HintPath>..\..\..\MelonLoader\Il2CppAssemblies\Il2CppSprocket.Vehicles.Weapons.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild"
          AfterTargets="PostBuildEvent"
          Condition="'$(SkipModDeploy)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="G:\Sprocket\Mods" />
  </Target>

</Project>
